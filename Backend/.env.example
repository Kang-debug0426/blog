# =============================================================================
# IMCJK 新后端 — 环境变量样例
#
# 规则（ADR-006 / 本轮指令 §6）：
#   * 本文件 **只允许出现变量名**，不得出现任何真实凭据
#   * 真实 `.env` 不得提交进版本库（见 .gitignore）
#   * 源码中不得硬编码密码 / JWT secret / OSS AK
#
# 复制为 `.env` 后填入真实值。所有值均可被真实环境变量覆盖。
# =============================================================================

# ---------------------------------------------------------------------------
# Database —— 单一 MySQL 库
# 【FACT】冻结为「同一实例、同一库」（TECHNICAL_ARCHITECTURE.md §6.1）
# 【说明】本轮任务指令的配置清单里出现 db_meta / db_dw 两个库名，
#         与本项目冻结的单库设计不符 → 按“优先保持设计文档”原则**不引入第二个库**，
#         此处仅保留一个 database 段。详见最终报告 RECONCILIATION-01。
# ---------------------------------------------------------------------------
DATABASE__HOST=127.0.0.1
DATABASE__PORT=3306
DATABASE__USER=
DATABASE__PASSWORD=
DATABASE__NAME=feitwnd
# 【FACT】旧连接串使用 serverTimezone=GMT+8（analyis/configs-redacted/application.yml）
DATABASE__TIMEZONE=+08:00
DATABASE__CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# Redis —— 与旧实例隔离：不同 db 号 和/或 不同 key 前缀（ADR-005 Decision #3 修订）
# ❌ 禁止 FLUSHDB / FLUSHALL（本轮指令 §7 / §19）
# ---------------------------------------------------------------------------
REDIS__HOST=127.0.0.1
REDIS__PORT=6379
REDIS__PASSWORD=
# 旧系统为 db 0 → 新系统用不同的 db 号实现隔离（默认 1）
REDIS__DB=1
# key 命名空间前缀（冻结：TECHNICAL_ARCHITECTURE.md §7.2）
REDIS__KEY_PREFIX=imcjk:

# ---------------------------------------------------------------------------
# JWT
# 旧契约（【FACT】）：
#   header 名 = Authorization（feiTwnd.jwt.token-name）
#   值为**裸 token**，不剥离 "Bearer " 前缀
#   claims = adminId / adminRole；TTL = 7200000 ms = 2h
# 【UNKNOWN·U-01】旧 token 的具体算法（HS256/384/512）无法确认（secret 已脱敏）
#   → algorithm 默认 "auto"：按 secret 的**字节长度**推导（复刻 jjwt Keys.hmacShaKeyFor 语义）
#   → 也可显式指定 HS256 / HS384 / HS512
# ---------------------------------------------------------------------------
JWT__SECRET_KEY=
JWT__TTL_MS=7200000
JWT__TOKEN_NAME=Authorization
JWT__ALGORITHM=auto

# ---------------------------------------------------------------------------
# OSS（D5/D6 FROZEN：不换 bucket、不搬对象、不删对象、不改 URL）
# Phase 2.1 只做 URL / object-key 规则，**不做任何网络调用**
# ---------------------------------------------------------------------------
OSS__ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS__ACCESS_KEY_ID=
OSS__ACCESS_KEY_SECRET=
OSS__BUCKET_NAME=kjc-blog-2026

# ---------------------------------------------------------------------------
# SMTP（sendCode 使用；Phase 2.1 只建接口，不真实发送）
# ---------------------------------------------------------------------------
SMTP__HOST=smtp.qq.com
SMTP__PORT=587
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROM=

# ---------------------------------------------------------------------------
# 游客固定验证码（D1 FROZEN = 保留旧行为）
# 【FACT】旧值来自 feitwnd.visitor.verify-code（一个邮箱地址字符串）
# ---------------------------------------------------------------------------
VISITOR__VERIFY_CODE=

# ---------------------------------------------------------------------------
# 应用 / 日志
# 【FACT】旧系统 logging.level.cc.feitwnd.mapper = debug（全量打印 SQL）
#        新系统生产必须 INFO，禁止 mapper: debug
# ---------------------------------------------------------------------------
APP__NAME=imcjk-backend
APP__API_PREFIX=/api
APP__ENV=development
LOG__LEVEL=INFO
LOG__SQL_ECHO=false
